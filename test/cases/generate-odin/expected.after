			break
		}

		if rc = apply(&m, patch, applied_by); rc == .OK {
			applied += 1
		}
	}

	if rc == .OK {
		rc = exec(&m, "commit", "committing the migration")
	}

	if rc != .OK {
		if sqlite3_get_autocommit(db) == 0 {
			sqlite3_exec(db, "rollback", nil, nil, nil)
		}

		return 0, m.message, rc
	}

	return applied, "", .OK
}
