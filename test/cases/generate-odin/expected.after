	"total",
}

/* Reads the current row of a statement selecting what count_users selects. */
count_users_read :: proc(stmt: ^Sqlite3_Stmt, allocator: runtime.Allocator) -> (row: Count_Users_Row, rc: Result) {
	if rc = check_columns(stmt, COLUMNS[:]); rc != .OK {
		return
	}

	{
		row.total = sqlite3_column_int64(stmt, 0)
	}

	return row, .OK
}

@(private = "file")
SQL_query :: "select count(*) as total from users"

/*
 * Its one row: .ROW.
 */
count_users :: proc(
	ctx: ^Context,
	allocator := context.allocator,
) -> (
	row: Count_Users_Row,
	rc: Result,
) {
	stmt: ^Sqlite3_Stmt

	if stmt, rc = prepared(ctx, .Query_Count_Users, SQL_query); rc != .OK {
		return
	}

	rc = Result(sqlite3_step(stmt))

	if rc == .ROW {
		row, rc = count_users_read(stmt, allocator)
		rc = .ROW if rc == .OK else rc
	}

	return row, finish(stmt, rc)
