package db

@(private = "file")
SQL_query :: "insert into sessions (user, family, token_hash, expires_at, created_at) values (?, ?, ?, ?, ?)"

/*
 * .OK when it changed a row, .DONE when it changed none.
 */
add_session :: proc(
	ctx: ^Context,
	user: Users_Serial,
	family: string,
	token_hash: string,
	expires_at: i64,
	created_at: i64,
) -> (
	rc: Result,
) {
	stmt: ^Sqlite3_Stmt

	if stmt, rc = prepared(ctx, .Query_Add_Session, SQL_query); rc != .OK {
		return
	}

	rc = bind_id(stmt, 1, u64(user))
	if rc != .OK {
		rc = finish(stmt, rc)
		return
	}

	rc = bind_text(stmt, 2, family, false)
	if rc != .OK {
		rc = finish(stmt, rc)
		return
	}

	rc = bind_text(stmt, 3, token_hash, false)
	if rc != .OK {
		rc = finish(stmt, rc)
		return
	}

	rc = Result(sqlite3_bind_int64(stmt, 4, expires_at))
	if rc != .OK {
		rc = finish(stmt, rc)
		return
	}

	rc = Result(sqlite3_bind_int64(stmt, 5, created_at))
	if rc != .OK {
		rc = finish(stmt, rc)
		return
	}

	rc = run(stmt)

	if rc == .DONE {
		rc = .OK if sqlite3_changes(ctx.db) > 0 else .DONE
	}

	return finish(stmt, rc)
}
