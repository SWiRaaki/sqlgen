	return Result(sqlite3_bind_null(stmt, index))
}

@(private = "package")
bind_id :: proc(stmt: ^Sqlite3_Stmt, index: i32, id: u64) -> Result {
	if id > u64(max(i64)) {
		return .RANGE
	}

	return Result(sqlite3_bind_int64(stmt, index, i64(id)))
