	}

	return detail::finish(stmt, rc == SQLITE_DONE ? SQLITE_OK : rc);
}

static const char sql_2[] =
	"update doubled set w = ?1 where id = ?2";

int update_by_key(Context &ctx,
		int64_t p_w,
		DoubledId p_id) {
