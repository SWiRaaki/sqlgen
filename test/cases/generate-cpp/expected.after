static const char sql_query[] =
	"select count(*) as total from users";

int run(Context &ctx,
		Row &out) {
	sqlite3_stmt *stmt = nullptr;
	int           rc   = detail::Access::statement(ctx, detail::QUERY_COUNT_USERS, sql_query, stmt);

	if (rc != SQLITE_OK) {
		return rc;
