#include "db_internal.hpp"

namespace db {
namespace add_session {

static const char sql_query[] =
	"insert into sessions (user, family, token_hash, expires_at, created_at) values (?, ?, ?, ?, ?)";

int run(Context &ctx,
		UsersSerial p_user,
		const std::string &p_family,
		const std::string &p_token_hash,
		int64_t p_expires_at,
		int64_t p_created_at) {
	sqlite3_stmt *stmt = nullptr;
	int           rc   = detail::Access::statement(ctx, detail::QUERY_ADD_SESSION, sql_query, stmt);

	if (rc != SQLITE_OK) {
		return rc;
	}

	if ((rc = detail::bind_id(stmt, 1, p_user.v)) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	if ((rc = detail::bind_text(stmt, 2, p_family, false)) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	if ((rc = detail::bind_text(stmt, 3, p_token_hash, false)) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	if ((rc = sqlite3_bind_int64(stmt, 4, static_cast<sqlite3_int64>(p_expires_at))) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	if ((rc = sqlite3_bind_int64(stmt, 5, static_cast<sqlite3_int64>(p_created_at))) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	rc = detail::run(stmt);

	if (rc == SQLITE_DONE) {
		rc = sqlite3_changes(ctx.db()) > 0 ? SQLITE_OK : SQLITE_DONE;
	}

	return detail::finish(stmt, rc);
}

} // namespace add_session
} // namespace db
