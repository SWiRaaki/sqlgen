static const char sql_11[] =
	"insert into users (username, email, display_text, role, created_at, updated_at) values (?1, ?2, ?3, coalesce(?4, ('reader')), ?5, ?6) on conflict (email) do update set username = excluded.username, display_text = excluded.display_text, role = excluded.role, created_at = excluded.created_at, updated_at = excluded.updated_at";

