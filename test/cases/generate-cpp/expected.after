	if ((rc = sqlite3_bind_int64(stmt, 2, static_cast<sqlite3_int64>(p_w))) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	rc = detail::run(stmt);

	if (rc == SQLITE_DONE) {
		rc = sqlite3_changes(ctx.db()) > 0 ? SQLITE_OK : SQLITE_DONE;
