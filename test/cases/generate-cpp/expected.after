	}

	if ((rc = p_role.has_value ? detail::bind_text(stmt, 4, p_role.value, false) : sqlite3_bind_null(stmt, 4)) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	if ((rc = sqlite3_bind_int64(stmt, 5, static_cast<sqlite3_int64>(p_created_at))) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	if ((rc = p_updated_at.has_value ? sqlite3_bind_int64(stmt, 6, static_cast<sqlite3_int64>(p_updated_at.value)) : sqlite3_bind_null(stmt, 6)) != SQLITE_OK) {
		return detail::finish(stmt, rc);
	}

	rc = detail::run(stmt);

	if (rc == SQLITE_DONE) {
