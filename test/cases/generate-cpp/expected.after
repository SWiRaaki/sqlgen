	rc = sqlite3_step(stmt);

	if (rc == SQLITE_ROW) {
		rc = read(stmt, out);
		rc = rc == SQLITE_OK ? SQLITE_ROW : rc;
	}

	return detail::finish(stmt, rc);
}

