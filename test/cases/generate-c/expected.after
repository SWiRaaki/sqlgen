	free(done);

	if (rc == SQLITE_OK) {
		rc = run(db, "commit", "committing the migration", error);
	}

	if (rc != SQLITE_OK) {
		if (!sqlite3_get_autocommit(db)) {
			sqlite3_exec(db, "rollback", NULL, NULL, NULL);
		}

		return rc;
	}

	if (applied) {
		*applied = count;
	}

