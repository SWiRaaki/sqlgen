#include "db_internal.h"

static const char sql_query[] =
	"insert into sessions (user, family, token_hash, expires_at, created_at) values (?, ?, ?, ?, ?)";

int db_add_session(db_ctx *ctx,
		db_users_serial p_user,
		const char *p_family, size_t p_family_len,
		const char *p_token_hash, size_t p_token_hash_len,
		int64_t p_expires_at,
		int64_t p_created_at) {
	sqlite3_stmt *stmt;
	int           rc = db__statement(ctx, DB_QUERY_ADD_SESSION, sql_query, &stmt);

	if (rc != SQLITE_OK) {
		return rc;
	}

	if ((rc = db__bind_id(stmt, 1, p_user.v)) != SQLITE_OK) {
		return db__finish(stmt, rc);
	}

	if ((rc = db__bind_text(stmt, 2, p_family, p_family_len)) != SQLITE_OK) {
		return db__finish(stmt, rc);
	}

	if ((rc = db__bind_text(stmt, 3, p_token_hash, p_token_hash_len)) != SQLITE_OK) {
		return db__finish(stmt, rc);
	}

	if ((rc = sqlite3_bind_int64(stmt, 4, (sqlite3_int64)p_expires_at)) != SQLITE_OK) {
		return db__finish(stmt, rc);
	}

	if ((rc = sqlite3_bind_int64(stmt, 5, (sqlite3_int64)p_created_at)) != SQLITE_OK) {
		return db__finish(stmt, rc);
	}

	rc = db__run(stmt);

	if (rc == SQLITE_DONE) {
		rc = sqlite3_changes(db_ctx_db(ctx)) > 0 ? SQLITE_OK : SQLITE_DONE;
	}

	return db__finish(stmt, rc);
}
