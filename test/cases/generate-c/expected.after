#ifndef DB_H
#define DB_H

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>

#include <sqlite3.h>

/*
 * Every function returns an SQLite result code:
 *   SQLITE_ROW       a get or a one-row query found its row; a cursor stepped to its next row
 *   SQLITE_DONE      a get or a one-row query found no row; a cursor has no more rows; a write
 *                    changed no row
 *   SQLITE_OK        a write changed at least one row; anything else succeeded
 *   SQLITE_MISMATCH  a statement handed to a _read function does not select that table's columns
 *   SQLITE_RANGE     an id outside what both uint64_t and SQLite's int64 can hold
 *   anything else    the error SQLite reported
 *
 * A row owns its text and blobs; every function filling a row frees what it held first, so a row
 * starts zeroed ({0}) and can then be reused. _row_free releases it.
 */

/* Text a row owns: allocated with malloc, NUL-terminated; len does not count the NUL. */
typedef struct {
	char   *ptr;
	size_t  len;
} db_text;

/* Bytes a row owns: allocated with malloc; ptr is NULL when len is 0. */
typedef struct {
	unsigned char *ptr;
	size_t         len;
} db_blob;

/* A column without a fixed type: type is SQLITE_INTEGER, SQLITE_FLOAT, SQLITE_TEXT, SQLITE_BLOB or
 * SQLITE_NULL, and says which member holds the value. */
typedef struct {
	int         type;
	int64_t     integer;
	double      real;
	db_text text;
	db_blob blob;
} db_value;

/* One connection's prepared statements. */
typedef struct db_ctx db_ctx;

/* The rows of a list or a query; step with its row's _next, release with db_cursor_close. */
typedef struct {
	sqlite3_stmt *stmt;
	bool          owned;
} db_cursor;

int      db_ctx_open(db_ctx **out, sqlite3 *db);
void     db_ctx_close(db_ctx *ctx);
sqlite3 *db_ctx_db(const db_ctx *ctx);

void db_cursor_close(db_cursor *cursor);
void db_text_free(db_text *text);
void db_blob_free(db_blob *blob);
void db_value_free(db_value *value);

/* The primary key of doubled: a type of its own, so an id of another table does not fit. */
typedef struct {
	uint64_t v;
} db_doubled_id;

#define DB_DOUBLED_ID(n) ((db_doubled_id){ .v = (n) })

/* The primary key of sessions: a type of its own, so an id of another table does not fit. */
typedef struct {
	uint64_t v;
} db_sessions_serial;

#define DB_SESSIONS_SERIAL(n) ((db_sessions_serial){ .v = (n) })

/* The primary key of sys_state: a type of its own, so an id of another table does not fit. */
typedef struct {
	uint64_t v;
} db_sys_state_id;

#define DB_SYS_STATE_ID(n) ((db_sys_state_id){ .v = (n) })

/* The primary key of tag: a type of its own, so an id of another table does not fit. */
typedef struct {
	uint64_t v;
} db_tag_id;

#define DB_TAG_ID(n) ((db_tag_id){ .v = (n) })

/* The primary key of users: a type of its own, so an id of another table does not fit. */
typedef struct {
	uint64_t v;
} db_users_serial;

#define DB_USERS_SERIAL(n) ((db_users_serial){ .v = (n) })

/* One schema script, its text exactly as it runs. */
typedef struct {
	const char *name;
	const char *sql;
} db_script;

/* One patch: its version, parsed, and its scripts in the order they run. */
typedef struct {
	const char            *version;
	uint64_t               major;
	uint64_t               minor;
	uint64_t               patch;
	const char            *prerelease;
	const char            *build;
	const db_script *scripts;
	size_t                 count;
} db_patch;

/* The script creating the system tables, run before every patch; NULL when there is none. */
extern const db_script *const db_systables;

/* Every patch, in the order of their versions' precedence. */
extern const db_patch *const db_patches;
extern const size_t db_patch_count;

/* A hash of every script's name and text, in order: it changes whenever the schema does. */
extern const char db_schema_hash[];

/*
 * Brings db up to this program's schema, in one transaction: creates _sys_patch and _sys_script if
 * they are missing, runs the system-tables script, then applies every patch the database lacks, in
 * order, recording each with applied_by and the text of every script.
 *
 * Refused, with nothing changed: a patch the database has but this program does not carry (a newer
 * program migrated it); an applied script whose text changed, or that vanished or was added; a
 * missing patch older than one already applied.
 *
 * *applied receives how many patches ran. On failure *error receives a message, to release with
 * sqlite3_free. Either may be NULL.
 */
int db_migrate(sqlite3 *db, const char *applied_by, size_t *applied, char **error);

#include "db_doubled.h"
#include "db_sessions.h"
#include "db_setting.h"
#include "db_sys_state.h"
#include "db_tag.h"
#include "db_user_tag.h"
