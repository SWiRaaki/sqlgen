	if (rc == SQLITE_OK) {
		rc = sqlite3_prepare_v2(db, "insert into _sys_script (patch, ordinal, name, sql, created_at)"
				" values (?1, ?2, ?3, ?4, " NOW ")", -1, &stmt, NULL);
