	long           newest = -1;
	size_t         count  = 0;
	int            rc;

	if (error) {
		*error = NULL;
	}

	if (applied) {
		*applied = 0;
	}

	if ((rc = run(db, "begin immediate", "starting the migration", error)) != SQLITE_OK) {
		return rc;
	}

	rc = run(db, tables_sql, "creating _sys_patch and _sys_script", error);

	if (rc == SQLITE_OK && db_systables) {
		rc = run(db, db_systables->sql, db_systables->name, error);
	}

	if (rc == SQLITE_OK && !(done = calloc(db_patch_count + 1, 1))) {
		rc = fail(error, SQLITE_NOMEM, "out of memory");
	}

	if (rc == SQLITE_OK) {
		rc = read_applied(db, done, &newest, error);
	}

	for (size_t i = 0; rc == SQLITE_OK && i < db_patch_count; ++i) {
		if (done[i]) {
			continue;
		}

		if ((long)i < newest) {
			rc = fail(error, SQLITE_ERROR, "patch %s is older than %s, which is already applied; patches"
					" apply in order, so it cannot run now", db_patches[i].version,
