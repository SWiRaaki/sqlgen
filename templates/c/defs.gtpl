\* Snippets the other templates call. This file produces nothing itself. *\
\define header(source, patch) {
/*
 * Generated by \(generator.name) \(generator.version) on \(generated_at) -- do not edit.
 * Regenerate with: \(command)
 *
 * Source: \(source)\if (patch) {, patch \(patch)\}
 * Schema: \(scripts.patches | count) \if (scripts.patches | count == 1) {patch\} \else {patches\}, hash \(hash)
 */
\}
\* A column as a function parameter: text and blobs as pointer and length (NULL is SQL NULL), a
   value as a pointer (NULL is SQL NULL), anything else optional as a pointer (NULL is SQL NULL, or
   the column's default or a new rowid), anything else by value. *\
\define param(c, optional) {\if (c | storage == "text") {const char *p_\(c.words | snake), size_t p_\(c.words | snake)_len\} \elif (c | storage == "blob") {const void *p_\(c.words | snake), size_t p_\(c.words | snake)_len\} \elif (c | storage == "value") {const \(prefix)_value *p_\(c.words | snake)\} \elif (optional or c.nullable) {const \(c | ctype) *p_\(c.words | snake)\} \else {\(c | ctype) p_\(c.words | snake)\}\}
\* Binding a parameter to placeholder n; on an error, a "cursor" is closed and a "statement" reset. *\
\define bind(c, optional, n, fail) {
\if (c | storage == "text") {
	if ((rc = \(prefix)__bind_text(stmt, \(n), p_\(c.words | snake), p_\(c.words | snake)_len)) != SQLITE_OK) {
\} \elif (c | storage == "blob") {
	if ((rc = \(prefix)__bind_blob(stmt, \(n), p_\(c.words | snake), p_\(c.words | snake)_len)) != SQLITE_OK) {
\} \elif (c | storage == "value") {
	if ((rc = \(prefix)__bind_value(stmt, \(n), p_\(c.words | snake))) != SQLITE_OK) {
\} \elif (c | storage == "id" and (optional or c.nullable)) {
	if ((rc = p_\(c.words | snake) ? \(prefix)__bind_id(stmt, \(n), p_\(c.words | snake)->v) : sqlite3_bind_null(stmt, \(n))) != SQLITE_OK) {
\} \elif (c | storage == "id") {
	if ((rc = \(prefix)__bind_id(stmt, \(n), p_\(c.words | snake).v)) != SQLITE_OK) {
\} \elif (c | storage == "int" and (optional or c.nullable)) {
	if ((rc = p_\(c.words | snake) ? sqlite3_bind_int64(stmt, \(n), (sqlite3_int64)*p_\(c.words | snake)) : sqlite3_bind_null(stmt, \(n))) != SQLITE_OK) {
\} \elif (c | storage == "int") {
	if ((rc = sqlite3_bind_int64(stmt, \(n), (sqlite3_int64)p_\(c.words | snake))) != SQLITE_OK) {
\} \elif (optional or c.nullable) {
	if ((rc = p_\(c.words | snake) ? sqlite3_bind_double(stmt, \(n), (double)*p_\(c.words | snake)) : sqlite3_bind_null(stmt, \(n))) != SQLITE_OK) {
\} \else {
	if ((rc = sqlite3_bind_double(stmt, \(n), (double)p_\(c.words | snake))) != SQLITE_OK) {
\}
		return \if (fail == "cursor") {\(prefix)__cursor_fail(out, rc)\} \else {\(prefix)__finish(stmt, rc)\};
	}

\}
\* A constant named kind_a, or kind_a_b, holding text: a string literal while C99 promises one can
   hold it (4095 bytes), a byte array beyond that. *\
\define ctext(kind, a, b, text) {
\if (text | count <= 4095) {
static const char \(kind)_\(a)\if (b != null) {_\(b)\}[] =
	\(text | cstrings | join("\n\t"));
\} \else {
static const char \(kind)_\(a)\if (b != null) {_\(b)\}[] = {
\for (bytes in text | cbytes) {
	\(bytes)
\}
};
\}
\}
\* Reading column i of the current row into out. *\
\define read(c, i) {
\if (c | storage == "value") {
	if ((rc = \(prefix)__read_value(stmt, \(i), &out->\(c.words | cname))) != SQLITE_OK) {
		\(prefix)_\(t.words | snake)_row_free(out);
		return rc;
	}
\} \elif (c | storage == "text" or c | storage == "blob" or c | storage == "id") {
\if (c.nullable) {
	out->has_\(c.words | snake) = sqlite3_column_type(stmt, \(i)) != SQLITE_NULL;

	if (out->has_\(c.words | snake) && (rc = \(prefix)__read_\(c | storage)(stmt, \(i), &out->\(c.words | cname)\if (c | storage == "id") {.v\})) != SQLITE_OK) {
\} \else {
	if ((rc = \(prefix)__read_\(c | storage)(stmt, \(i), &out->\(c.words | cname)\if (c | storage == "id") {.v\})) != SQLITE_OK) {
\}
		\(prefix)_\(t.words | snake)_row_free(out);
		return rc;
	}
\} \elif (c.nullable) {
	out->has_\(c.words | snake) = sqlite3_column_type(stmt, \(i)) != SQLITE_NULL;
	out->\(c.words | cname) = out->has_\(c.words | snake) ? (\(c | ctype))sqlite3_column_\if (c | storage == "int") {int64\} \else {double\}(stmt, \(i)) : 0;
\} \else {
	out->\(c.words | cname) = (\(c | ctype))sqlite3_column_\if (c | storage == "int") {int64\} \else {double\}(stmt, \(i));
\}

\}
