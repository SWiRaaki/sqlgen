\* Snippets the other templates call. This file produces nothing itself. *\
\define header(source, patch) {
/*
 * Generated by \(generator.name) \(generator.version) on \(generated_at) -- do not edit.
 * Regenerate with: \(command)
 *
 * Source: \(source)\if (patch) {, patch \(patch)\}
 * Schema: \(scripts.patches | count) \if (scripts.patches | count == 1) {patch\} \else {patches\}, hash \(hash)
 */
\}
\* A column as a function parameter: by const reference, wrapped in nullable when it may be NULL
   or left out (no value is SQL NULL, or the column's default or a new rowid); a value column's own
   type SQLITE_NULL is SQL NULL; an id or number that is always there by value. *\
\define param(c, optional) {\if (c | storage == "value") {const Value &p_\(c.words | snake)\} \elif (optional or c.nullable) {const nullable<\(c | cpptype)> &p_\(c.words | snake)\} \elif (c | storage == "text" or c | storage == "blob") {const \(c | cpptype) &p_\(c.words | snake)\} \else {\(c | cpptype) p_\(c.words | snake)\}\}
\* Binding the value of a parameter (its member, for a nullable one) to placeholder n, as an expression. *\
\define bind_one(c, n, member, copy) {\if (c | storage == "text") {detail::bind_text(stmt, \(n), p_\(c.words | snake)\(member), \(copy))\} \elif (c | storage == "blob") {detail::bind_blob(stmt, \(n), p_\(c.words | snake)\(member), \(copy))\} \elif (c | storage == "id") {detail::bind_id(stmt, \(n), p_\(c.words | snake)\(member).v)\} \elif (c | storage == "int") {sqlite3_bind_int64(stmt, \(n), static_cast<sqlite3_int64>(p_\(c.words | snake)\(member)))\} \else {sqlite3_bind_double(stmt, \(n), static_cast<double>(p_\(c.words | snake)\(member)))\}\}
\* Binding a parameter to placeholder n; on an error, a "cursor" is closed and a "statement" reset.
   A cursor's text and blobs are copied: it steps on after the call that bound them returns. *\
\define bind(c, optional, n, fail) {
\if (c | storage == "value") {
	if ((rc = detail::bind_value(stmt, \(n), p_\(c.words | snake), \if (fail == "cursor") {true\} \else {false\})) != SQLITE_OK) {
\} \elif (optional or c.nullable) {
	if ((rc = p_\(c.words | snake).has_value ? \call bind_one(c, n, ".value", fail == "cursor") : sqlite3_bind_null(stmt, \(n))) != SQLITE_OK) {
\} \else {
	if ((rc = \call bind_one(c, n, "", fail == "cursor")) != SQLITE_OK) {
\}
\if (fail == "cursor") {
		out.close();
		return rc;
\} \else {
		return detail::finish(stmt, rc);
\}
	}

\}
\* A constant named kind_a, or kind_a_b, holding text: a string literal while it is short, a byte
   array beyond 4095 bytes, as for C. *\
\define ctext(kind, a, b, text) {
\if (text | count <= 4095) {
static const char \(kind)_\(a)\if (b != null) {_\(b)\}[] =
	\(text | cstrings | join("\n\t"));
\} \else {
static const char \(kind)_\(a)\if (b != null) {_\(b)\}[] = {
\for (bytes in text | cbytes) {
	\(bytes)
\}
};
\}
\}
\* Reading column i of the current row into out; a nullable member gets has_value, and its value
   only when it has one. *\
\define read(c, i) {
\if (c | storage == "value") {
	if ((rc = detail::read_value(stmt, \(i), out.\(c.words | cppname))) != SQLITE_OK) {
		return rc;
	}
\} \elif (c.nullable) {
	out.\(c.words | cppname).has_value = sqlite3_column_type(stmt, \(i)) != SQLITE_NULL;

\call read_one(c, i, ".value", true)
\} \else {
\call read_one(c, i, "", false)
\}

\}
\define read_one(c, i, member, guarded) {
\if (c | storage == "text" or c | storage == "blob" or c | storage == "id") {
	if (\if (guarded) {out.\(c.words | cppname).has_value && \}(rc = detail::read_\(c | storage)(stmt, \(i), out.\(c.words | cppname)\(member)\if (c | storage == "id") {.v\})) != SQLITE_OK) {
		return rc;
	}
\} \elif (guarded) {
	if (out.\(c.words | cppname).has_value) {
		out.\(c.words | cppname).value = static_cast<\(c | cpptype)>(sqlite3_column_\if (c | storage == "int") {int64\} \else {double\}(stmt, \(i)));
	}
\} \else {
	out.\(c.words | cppname) = static_cast<\(c | cpptype)>(sqlite3_column_\if (c | storage == "int") {int64\} \else {double\}(stmt, \(i)));
\}
\}
\* A row's members: each column, wrapped in nullable when it can be NULL (a value column says NULL
   by its type). *\
\define members(columns) {
\align {
\for (c in columns) {
\if (c.nullable and c | storage != "value") {
	nullable<\(c | cpptype)>\|\(c.words | cppname);
\} \else {
	\(c | cpptype)\|\(c.words | cppname);
\}
\}
\}
\}
\* A query's function, without its body or semicolon. *\
\define signature(q) {
int run(Context &ctx\for (p in q.params) {,
		\call param(p, false)\}\if (q.rows == "many") {,
		Cursor<Row> &out\} \elif (q.rows != "none") {,
		Row &out\})\}
