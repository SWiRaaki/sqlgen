\* The schema as a Mermaid entity-relationship diagram: every table and virtual table with its
   columns -- PK, FK, and UK for a column that is a unique key alone -- and a line per foreign key. A key's end at the parent is `||` (exactly one), or `|o`
   when the child's columns can be NULL; at the child `o{` (any number), or `o|` when they are a
   unique key of the child (at most one). *\
%% Generated by \(generator.name) \(generator.version) on \(generated_at) -- do not edit.
%% Regenerate with: \(command)
erDiagram
\for (t in model.tables) {
\if (t.kind != "view") {
    \(t.name | mmword) {
\for (c in t.columns) {
\if (not c.hidden) {
        \if (c.declared_type == "") {any\} \else {\(c.declared_type | mmword)\} \(c.name | mmword)\if (c.primary_key > 0) { PK\}\if (t.foreign_keys | pluck("columns") | flatten | contains(c.name)) {\if (c.primary_key > 0) {,\} FK\}\for (k in t.unique_keys) {\if (k.columns | count == 1 and k.columns | first == c.name and c.primary_key == 0) {\if (t.foreign_keys | pluck("columns") | flatten | contains(c.name)) {,\} UK\}\}
\}
\}
    }
\}
\}
\for (t in model.tables) {
\for (fk in t.foreign_keys) {
\if (fk.parent_exists) {
    \(fk.parent | mmword) \if (fk.optional) {|o\} \else {||\}--\if (fk.unique) {o|\} \else {o{\} \(t.name | mmword) : "\(fk.columns | join(", "))"
\}
\}
\}
