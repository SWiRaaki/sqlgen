\* Snippets the other templates call. This file produces nothing itself. *\
\define header(source, patch) {
/*
 * Generated by \(generator.name) \(generator.version) on \(generated_at) -- do not edit.
 * Regenerate with: \(command)
 *
 * Source: \(source)\if (patch) {, patch \(patch)\}
 * Schema: \(scripts.patches | count) \if (scripts.patches | count == 1) {patch\} \else {patches\}, hash \(hash)
 */
\}
\* A column as a procedure parameter: wrapped in Maybe when it may be NULL or left out (nil is SQL
   NULL, or the column's default or a new rowid); a value column says NULL by being nil itself. *\
\define param(c, optional) {\(c.words | odinparam): \if (c | storage != "value" and (optional or c.nullable)) {Maybe(\(c | odintype))\} \else {\(c | odintype)\}\}
\* Binding expression for one present value. *\
\define bind_one(c, n, x, copy) {\if (c | storage == "text") {bind_text(stmt, \(n), \(x), \(copy))\} \elif (c | storage == "blob") {bind_blob(stmt, \(n), \(x), \(copy))\} \elif (c | storage == "value") {bind_value(stmt, \(n), \(x), \(copy))\} \elif (c | storage == "id") {bind_id(stmt, \(n), u64(\(x)))\} \elif (c | storage == "int") {Result(sqlite3_bind_int64(stmt, \(n), \(x)))\} \else {Result(sqlite3_bind_double(stmt, \(n), \(x)))\}\}
\* Binding a parameter to placeholder n; on an error a "cursor" is closed and a "statement" reset,
   and the procedure returns. A cursor's text and blobs are copied: it steps on after the call that
   bound them returns. *\
\define bind(c, optional, n, fail) {
\if (c | storage != "value" and (optional or c.nullable)) {
	if it, has := \(c.words | odinparam).?; has {
		rc = \call bind_one(c, n, "it", fail == "cursor")
	} else {
		rc = Result(sqlite3_bind_null(stmt, \(n)))
	}
\} \else {
	rc = \call bind_one(c, n, c.words | odinparam, fail == "cursor")
\}
	if rc != .OK {
\if (fail == "cursor") {
		cursor_close(&cursor)
\} \else {
		rc = finish(stmt, rc)
\}
		return
	}

\}
\* A constant SQL_<n> holding text, one literal per line joined into one. *\
\define otext(n, text) {
@(private = "file")
SQL_\(n) :: \(text | odinstrings | join(" +\n\t"))
\}
\* Reading column i of the current row into row; on an error what was read is freed. A column
   that can be NULL keeps its zero value (nil, for a Maybe) when it holds NULL. *\
\define read(c, i, owner) {
\if (c.nullable) {
	if sqlite3_column_type(stmt, \(i)) != SQLITE_NULL {
\} \else {
	{
\}
\if (c | storage == "int") {
		row.\(c.words | odinname) = sqlite3_column_int64(stmt, \(i))
\} \elif (c | storage == "real") {
		row.\(c.words | odinname) = sqlite3_column_double(stmt, \(i))
\} \elif (c | storage == "id") {
		raw: u64
		raw, rc = read_id(stmt, \(i))
		row.\(c.words | odinname) = \(c | odintype)(raw)
\} \elif (c | storage == "text") {
		it: string
		it, rc = read_text(stmt, \(i), allocator)
		row.\(c.words | odinname) = it
\} \elif (c | storage == "blob") {
		it: []u8
		it, rc = read_blob(stmt, \(i), allocator)
		row.\(c.words | odinname) = it
\} \else {
		it: Value
		it, rc = read_value(stmt, \(i), allocator)
		row.\(c.words | odinname) = it
\}
	}
\if (c | storage != "int" and c | storage != "real") {

	if rc != .OK {
		\(owner)_row_destroy(&row, allocator)
		return {}, rc
	}
\}

\}
\* A row's members: each column, in Maybe when it can be NULL (a value column says NULL by being nil). *\
\define members(columns) {
\align {
\for (c in columns) {
	\(c.words | odinname):\|\if (c.nullable and c | storage != "value") {Maybe(\(c | odintype))\} \else {\(c | odintype)\},
\}
\}
\}
\* Freeing what a row owns. *\
\define destroy_members(columns) {
\for (c in columns) {
\if (c | storage == "text" or c | storage == "blob") {
\if (c.nullable) {
	if it, has := row.\(c.words | odinname).?; has {
		delete(it, allocator)
	}
\} \else {
	delete(row.\(c.words | odinname), allocator)
\}
\} \elif (c | storage == "value") {
	value_destroy(row.\(c.words | odinname), allocator)
\}
\}
\}
